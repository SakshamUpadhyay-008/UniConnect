# MongoDB Connection String (Local instance or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/uniconnect_db

# Express Server Port
PORT=5000

# JSON Web Token Secret (Provide a long, high-entropy secret in production)
JWT_SECRET=your_long_random_jwt_secret_key_here_min_32_chars

# Node Environment
NODE_ENV=development

# Allowed Frontend Origin
CORS_ORIGIN=http://localhost:5173
